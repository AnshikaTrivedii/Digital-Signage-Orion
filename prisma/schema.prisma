generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SALES
  SUPPORT
}

enum OrganizationRole {
  ORG_ADMIN
  MANAGER
  CONTENT_EDITOR
  ANALYST_VIEWER
}

enum FeatureKey {
  DASHBOARD
  ASSETS
  PLAYLISTS
  SCHEDULE
  TICKERS
  DEVICES
  REPORTS
  TEAM
  SETTINGS
}

enum FeatureAccessLevel {
  NONE
  VIEW
  EDIT
  MANAGE
  CONTROL
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InvitationScope {
  ORGANIZATION
}

enum PlaylistStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
}

enum DeviceCacheDownloadStatus {
  DOWNLOADED
  PENDING
  FAILED
}

enum DeviceCacheLocalStatus {
  PRESENT
  MISSING
  CORRUPT
}

enum DeviceSyncReportStatus {
  OK
  PARTIAL
  FAILED
}

enum DeviceCacheCommandType {
  FORCE_SYNC
  CLEAR_CACHE
  REDOWNLOAD_PLAYLIST
  RESTART_PLAYER
  RESTART_DEVICE
  UPLOAD_LOGS
  TAKE_SCREENSHOT
  REFRESH_STATUS
}

enum DeviceSystemLogCategory {
  BOOT
  CRASH
  RESTART
  SYNC
  DOWNLOAD
  PROOF_OF_PLAY
  ERROR
}

enum DeviceCacheCommandStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
  FAILED
}

enum TickerSpeed {
  SLOW
  NORMAL
  FAST
}

enum TickerStyle {
  CLASSIC
  NEON
  GRADIENT
  MINIMAL
}

enum TickerStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum TickerPriority {
  LOW
  NORMAL
  URGENT
}

enum TickerPosition {
  TOP
  BOTTOM
}

enum TickerBroadcastScope {
  ALL_DEVICES
  SELECTED_DEVICES
}

/// Schedule status is never stored — it is derived from `enabled` plus the
/// current instant against startDateTime/endDateTime, so it can never go stale.

enum LayoutStatus {
  DRAFT
  ACTIVE
}

enum LayoutResolution {
  LANDSCAPE_1080P
  LANDSCAPE_4K
  PORTRAIT
}

enum ZoneType {
  PLAYLIST
  TICKER
  IMAGE
  HTML
  CLOCK
}

enum ProofOfPlayStatus {
  VERIFIED
  FAILED
}

enum AssetType {
  IMAGE
  VIDEO
  HTML
  DOCUMENT
  URL
}

enum AssetStatus {
  UPLOADING
  READY
  ERROR
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  fullName            String
  passwordHash        String
  platformRole        PlatformRole?
  status              UserStatus               @default(ACTIVE)
  memberships         OrganizationMembership[]
  sentInvitations     Invitation[]             @relation("InvitationSender")
  uploadedAssets      Asset[]                  @relation("AssetUploader")
  auditLogs           AuditLog[]               @relation("AuditActor")
  deviceCacheCommands DeviceCacheCommand[]     @relation("DeviceCacheCommandRequester")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model Organization {
  id                  String                   @id @default(cuid())
  name                String
  slug                String                   @unique
  status              OrganizationStatus       @default(DRAFT)
  primaryContactName  String?
  primaryContactEmail String?
  salesNotes          String?
  /// IANA zone used to interpret and render schedule wall-clock times.
  timezone            String                   @default("Asia/Kolkata")
  memberships         OrganizationMembership[]
  invitations         Invitation[]
  assets              Asset[]
  assetFolders        AssetFolder[]
  playlists           Playlist[]
  layouts             Layout[]
  schedules           Schedule[]
  devices             Device[]
  tickers             Ticker[]
  proofOfPlayLogs     ProofOfPlayLog[]
  auditLogs           AuditLog[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model Playlist {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  status         PlaylistStatus @default(DRAFT)
  screens        Int            @default(0)
  color          String         @default("#4ade80")
  syncVersion    Int            @default(1)
  lastPlayedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PlaylistItem[]
  playlistAssets PlaylistAsset[]
  layoutZones    LayoutZone[]
  devices        Device[]
  schedules      Schedule[]

  @@index([organizationId, createdAt])
}

model PlaylistItem {
  id              String   @id @default(cuid())
  playlistId      String
  name            String
  type            String
  durationSeconds Int
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
}

model PlaylistAsset {
  id              String   @id @default(cuid())
  playlistId      String
  assetId         String
  position        Int
  /// null = no playlist override; player uses device default playback duration.
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Same asset may appear multiple times in one playlist; each row is a distinct occurrence.
  @@index([playlistId, position])
  @@index([playlistId, assetId])
}

model Layout {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  status         LayoutStatus     @default(DRAFT)
  resolution     LayoutResolution @default(LANDSCAPE_1080P)
  syncVersion    Int              @default(1)
  screens        Int              @default(0)
  color          String           @default("#a78bfa")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zones        LayoutZone[]
  devices      Device[]

  @@index([organizationId, updatedAt])
}

model LayoutZone {
  id         String   @id @default(cuid())
  layoutId   String
  name       String
  type       ZoneType
  x          Float
  y          Float
  w          Float
  h          Float
  zIndex     Int      @default(0)
  color      String   @default("#00e5ff")
  playlistId String?
  assetId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  layout   Layout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  asset    Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([layoutId, zIndex])
}

/// A time-bounded playlist assignment. References the playlist by id — playlist
/// contents are never copied here.
model Schedule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  playlistId     String
  /// null = every device in the organization.
  deviceId       String?
  /// Absolute UTC instants. The operator's wall-clock input is converted using
  /// Organization.timezone, so comparisons against now() are always UTC-to-UTC.
  startDateTime  DateTime
  endDateTime    DateTime
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlist     Playlist     @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, startDateTime])
  @@index([organizationId, deviceId, enabled])
  @@index([playlistId])
}

model Device {
  id                       String       @id @default(cuid())
  organizationId           String?
  name                     String
  status                   DeviceStatus @default(OFFLINE)
  location                 String       @default("Pending")
  ip                       String       @default("Pending")
  resolution               String       @default("1920x1080")
  uptime                   String       @default("0s")
  cpu                      Int          @default(0)
  ram                      Int          @default(0)
  temp                     Int          @default(0)
  lastSync                 String       @default("Awaiting first sync")
  os                       String       @default("Unknown")
  currentContent           String?
  currentPlaylistId        String?
  currentLayoutId          String?
  lastAckedPlaylistVersion Int?
  lastAckedLayoutVersion   Int?
  /// Playlist the device last actually synced. A schedule can swap the effective
  /// playlist without changing syncVersion, so identity must be tracked too.
  lastAckedPlaylistId      String?
  /// Schedule id last applied by the device (null = no active schedule).
  /// Required so schedule start/end forces syncRequired even when playlistId is unchanged.
  lastAckedScheduleId      String?

  // Initial onboarding sync (first playlist download after pairing)
  pendingInitialSync     Boolean   @default(false)
  initialSyncRequestedAt DateTime?

  cachePlaylistName      String?
  cachePlaylistVersion   Int?
  cacheLayoutName        String?
  cacheLayoutVersion     Int?
  cacheTotalBytes        Int                     @default(0)
  cacheUsedBytes         Int                     @default(0)
  cacheStorageTotalBytes Int                     @default(0)
  cachedAssetCount       Int                     @default(0)
  expectedAssetCount     Int                     @default(0)
  pendingDownloadCount   Int                     @default(0)
  cacheLastReportedAt    DateTime?
  lastSuccessfulSyncAt   DateTime?
  lastFailedSyncAt       DateTime?
  lastSyncError          String?
  syncReportStatus       DeviceSyncReportStatus?

  // Pairing fields
  pairingCode   String? @unique
  pairingSecret String?
  deviceToken   String? @unique
  hardwareId    String? @unique
  isPaired      Boolean @default(false)

  // Enterprise device identity
  playerVersion  String    @default("")
  androidVersion String    @default("")
  lastSeenAt     DateTime?
  macAddress     String    @default("")
  deviceModel    String    @default("")
  manufacturer   String    @default("")
  orientation    String    @default("LANDSCAPE")
  /// When true, the player stretches playlist assets to fill the full display.
  stretchToFit   Boolean   @default(false)
  /// Device-level default durations (seconds), used only when the playlist slot
  /// leaves durationSeconds NULL. A playlist override always wins.
  defaultImageDuration       Int       @default(10)
  defaultVideoDuration       Int       @default(10)
  defaultDocumentDuration    Int       @default(20)
  defaultUrlDuration         Int       @default(20)
  playbackSettingsUpdatedAt  DateTime?
  timezone       String    @default("UTC")

  // Health telemetry
  storageTotalBytes     BigInt    @default(0)
  storageFreeBytes      BigInt    @default(0)
  networkStatus         String    @default("UNKNOWN")
  wifiSignalStrength    Int       @default(0)
  currentAsset          String?
  currentPlaylistName   String?
  playbackStatus        String    @default("UNKNOWN")
  playbackUptimeSeconds Int       @default(0)
  lastDownloadAt        DateTime?

  // Permission status (reported by player)
  permInternet           Boolean @default(false)
  permStorage            Boolean @default(false)
  permForegroundService  Boolean @default(false)
  permBootReceiver       Boolean @default(false)
  permWakeLock           Boolean @default(false)
  permNotification       Boolean @default(false)
  permBatteryOptDisabled Boolean @default(false)
  permAutoStart          Boolean @default(false)
  permKioskMode          Boolean @default(false)

  // Device settings (reported + CMS-managed)
  brightness           Int @default(100)
  volume               Int @default(100)
  screenTimeoutSeconds Int @default(300)

  // Player features (CMS-managed, synced to player)
  featureAutoSync        Boolean @default(true)
  featureOfflinePlayback Boolean @default(true)
  featureProofOfPlay     Boolean @default(true)
  featureTicker          Boolean @default(true)
  featureWatchdog        Boolean @default(true)
  featureCrashRecovery   Boolean @default(true)
  featureBackgroundSync  Boolean @default(true)
  featureAutoDownload    Boolean @default(true)
  featureRemoteLogs      Boolean @default(true)
  configVersion          Int     @default(1)

  // Screenshot
  lastScreenshotUrl String?
  lastScreenshotAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentPlaylist Playlist?            @relation(fields: [currentPlaylistId], references: [id], onDelete: SetNull)
  currentLayout   Layout?              @relation(fields: [currentLayoutId], references: [id], onDelete: SetNull)
  proofOfPlayLogs ProofOfPlayLog[]
  tickerTargets   TickerDevice[]
  cachedAssets    DeviceCachedAsset[]
  cacheCommands   DeviceCacheCommand[]
  systemLogs      DeviceSystemLog[]
  schedules       Schedule[]

  @@index([organizationId, createdAt])
  @@index([organizationId, currentPlaylistId])
  @@index([organizationId, currentLayoutId])
}

model Ticker {
  id              String               @id @default(cuid())
  organizationId  String
  text            String
  speed           TickerSpeed          @default(NORMAL)
  style           TickerStyle          @default(NEON)
  color           String               @default("#00e5ff")
  backgroundColor String               @default("#1a1f2e")
  position        TickerPosition       @default(BOTTOM)
  heightPercent   Int                  @default(10)
  broadcastScope  TickerBroadcastScope @default(ALL_DEVICES)
  status          TickerStatus         @default(DRAFT)
  priority        TickerPriority       @default(NORMAL)
  screens         Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceTargets TickerDevice[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model TickerDevice {
  tickerId  String
  deviceId  String
  createdAt DateTime @default(now())

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([tickerId, deviceId])
  @@index([deviceId])
}

model ProofOfPlayLog {
  id              String            @id @default(cuid())
  organizationId  String
  deviceId        String?
  device          String
  content         String
  assetName       String            @default("")
  playlistName    String?
  campaignName    String?
  status          ProofOfPlayStatus
  timestamp       DateTime
  startTime       DateTime
  endTime         DateTime?
  durationSeconds Int?
  createdAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceRef    Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // A device plays one asset at a time, so (device, asset, playback start) is the
  // natural key of a playback event. Enforcing it in the database makes ingest
  // idempotent: a device retrying a flush can never store the same play twice.
  @@unique([organizationId, deviceId, assetName, startTime], map: "ProofOfPlayLog_natural_key")
  @@index([organizationId, timestamp])
  @@index([organizationId, startTime])
  @@index([organizationId, deviceId, startTime])
  @@index([organizationId, startTime(sort: Desc), id(sort: Desc)], map: "ProofOfPlayLog_org_startTime_id_idx")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  MembershipFeaturePermission[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

model MembershipFeaturePermission {
  id           String             @id @default(cuid())
  membershipId String
  featureKey   FeatureKey
  accessLevel  FeatureAccessLevel
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, featureKey])
  @@index([featureKey])
}

model Invitation {
  id               String           @id @default(cuid())
  email            String
  token            String           @unique
  scope            InvitationScope
  status           InvitationStatus @default(PENDING)
  organizationId   String
  role             OrganizationRole
  permissions      Json?
  invitedById      String
  acceptedByUserId String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  targetType     String
  targetId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model AssetFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       AssetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     AssetFolder[] @relation("FolderHierarchy")
  assets       Asset[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
}

model Asset {
  id                     String      @id @default(cuid())
  organizationId         String
  folderId               String?
  name                   String
  type                   AssetType
  status                 AssetStatus @default(UPLOADING)
  mimeType               String
  fileSize               Int         @default(0)
  s3Key                  String?     @unique
  url                    String?
  defaultDurationSeconds Int?
  width                  Int?
  height                 Int?
  durationMs             Int?
  thumbnailS3Key         String?
  documentFormat         String?
  uploadedById           String
  tags                   String[]    @default([])
  contentVersion         Int         @default(1)
  contentHash            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder             AssetFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy         User                @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  playlistAssets     PlaylistAsset[]
  layoutZones        LayoutZone[]
  deviceCacheEntries DeviceCachedAsset[]

  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@index([organizationId, folderId])
}

model DeviceCachedAsset {
  id               String                    @id @default(cuid())
  deviceId         String
  assetId          String
  assetName        String
  assetType        String
  mimeType         String                    @default("")
  playlistId       String?
  playlistName     String?
  fileSize         Int                       @default(0)
  assetVersion     Int                       @default(1)
  contentHash      String?
  downloadStatus   DeviceCacheDownloadStatus @default(PENDING)
  localCacheStatus DeviceCacheLocalStatus    @default(MISSING)
  downloadedAt     DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  asset  Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([deviceId, assetId])
  @@index([deviceId])
}

model DeviceCacheCommand {
  id             String                   @id @default(cuid())
  deviceId       String
  command        DeviceCacheCommandType
  status         DeviceCacheCommandStatus @default(PENDING)
  requestedById  String?
  errorMessage   String?
  createdAt      DateTime                 @default(now())
  acknowledgedAt DateTime?
  completedAt    DateTime?

  device      Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("DeviceCacheCommandRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
}

model DeviceSystemLog {
  id        String                  @id @default(cuid())
  deviceId  String
  category  DeviceSystemLogCategory
  message   String
  metadata  Json?
  createdAt DateTime                @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([deviceId, category])
}
