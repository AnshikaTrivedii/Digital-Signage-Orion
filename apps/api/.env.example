DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orion_platform?schema=public"
# Same as DATABASE_URL for local dev. On Supabase production, set this to the
# *direct* connection (db.<ref>.supabase.co), not the pooler URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/orion_platform?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001

# Public URL for player download links when using local disk storage (Render sets RENDER_EXTERNAL_URL automatically)
API_PUBLIC_URL=http://localhost:3001

# Player sync polling interval in seconds (how often devices re-fetch the playlist manifest).
# Sent to devices in the player config. Defaults to 120s (2 min); clamped to 30–3600s.
PLAYER_SYNC_INTERVAL_SECONDS=120

# S3 Storage (auto-uses local disk when S3_ACCESS_KEY_ID is still the placeholder)
S3_USE_LOCAL_STORAGE=true
S3_BUCKET=orion-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_ENDPOINT=                        # optional, for MinIO/DO Spaces
S3_FORCE_PATH_STYLE=false           # set true for MinIO
