FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages ./packages
RUN npm ci
COPY prisma ./prisma
COPY apps/api ./apps/api
COPY scripts ./scripts
RUN npx prisma generate && npm run build:api

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV SKIP_STARTUP_MIGRATE=true
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates bash \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/scripts/start-api.sh ./scripts/start-api.sh
COPY --from=build /app/scripts/migrate-db.sh ./scripts/migrate-db.sh
RUN chmod +x ./scripts/start-api.sh ./scripts/migrate-db.sh
EXPOSE 3001
CMD ["bash", "scripts/start-api.sh"]
